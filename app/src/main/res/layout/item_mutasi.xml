<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F4F5F9"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivMutasi"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Badge Status (Nempel di atas kanan gambar) -->
        <TextView
            android:id="@+id/tvBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="#F44336"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Perbaikan"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivMutasi">

            <!-- Nama & Kode Aset (Meniru "Server Rakitan #5 \n(AST-005)") -->
            <TextView
                android:id="@+id/tvNamaDanKode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Aset \n(KODE)"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Keterangan (Meniru teks abu-abu kategori) -->
            <TextView
                android:id="@+id/tvKeteranganMutasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Keterangan..."
                android:textColor="#757575"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Tanggal (Meniru harga warna biru) -->
            <TextView
                android:id="@+id/tvTanggalMutasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="05/07/2026"
                android:textColor="#2A4B9B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>