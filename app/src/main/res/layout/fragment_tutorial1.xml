<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="32dp">

    <ImageView
        android:id="@+id/iv_ilustrasi_1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toTopOf="@id/tv_title_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_title_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Selamat Datang di\nBina Desa"
        android:textAlignment="center"
        android:textColor="#2D3748"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/tv_desc_1"
        app:layout_constraintTop_toBottomOf="@id/iv_ilustrasi_1" />

    <TextView
        android:id="@+id/tv_desc_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Kelola seluruh aset dan inventaris desa dengan mudah, transparan, dan efisien hanya dalam satu genggaman."
        android:textAlignment="center"
        android:textColor="#718096"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title_1" />

</androidx.constraintlayout.widget.ConstraintLayout>