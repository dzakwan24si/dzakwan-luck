<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="32dp">

    <ImageView
        android:id="@+id/iv_ilustrasi_3"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_menu_myplaces"
        app:tint="@color/primary_blue_desa"
        app:layout_constraintBottom_toTopOf="@id/tv_title_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_title_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Mulai Kelola\nSekarang!"
        android:textAlignment="center"
        android:textColor="#2D3748"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/tv_desc_3"
        app:layout_constraintTop_toBottomOf="@id/iv_ilustrasi_3" />

    <TextView
        android:id="@+id/tv_desc_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Akses berbagai fitur unggulan dan jadikan manajemen aset desamu lebih profesional."
        android:textAlignment="center"
        android:textColor="#718096"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title_3" />

</androidx.constraintlayout.widget.ConstraintLayout>