<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue_desa"
        app:title="Tambah Riwayat Pemeliharaan"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Nama Aset -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNamaAset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nama Aset (Contoh: Balai Desa)" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Kode Aset -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKodeAset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kode Aset (Contoh: AST-001)" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Tindakan -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTindakan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tindakan (Contoh: Ganti Atap Bocor)" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Biaya -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBiaya"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Total Biaya (Rp)" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Reminder (Opsional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReminderMenit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Ingatkan cek lokasi (dalam menit) - Opsional" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Checkbox Ada Bukti -->
            <CheckBox
                android:id="@+id/cbAdaBukti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Lampirkan File Bukti Pembayaran"
                android:fontFamily="@font/poppins_regular" />

            <!-- Tombol Simpan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanPemeliharaan"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:text="Simpan Data"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary_blue_desa" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>